# 把本文件复制为 .env 后按需修改。demo/.env 不要提交到 Git。

# 主密钥：用来加密保存在 SQLite 里的模型配置。
# 留空即可——首次启动时会自动生成一个并写回 .env。
# 生成后请不要改动：换了密钥，之前保存的模型配置就解不开了。
AGENT_KIT_MASTER_KEY=

# 模型配置：三项都填好，聊天才会启用。
# 不填也能启动，待办功能照常可用，只是聊天会禁用。
# 地址和模型名由你的 OpenAI 兼容服务商提供。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# BFF 访问凭据：留空表示不鉴权，方便本地直接访问。
# 一旦填了值，所有接口和事件流都要求带这个 Bearer 凭据。
BFF_API_TOKEN=

# 服务端口。8787 / 8788 已被 agent-kit 仓库里的示例占用。
PORT=8790

# SQLite 文件路径，相对 demo/ 目录。
DATABASE_PATH=demo.sqlite
